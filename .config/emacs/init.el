    (font-lock-string-face "green" "black")
    (font-lock-keyword-face "brightred" "black")
    (font-lock-builtin-face "cyan" "black")
    (font-lock-function-name-face "yellow" "black")
    (font-lock-variable-name-face "brightwhite" "black")
    (font-lock-constant-face "brightmagenta" "black")
    (font-lock-type-face "brightblue" "black")
    (font-lock-warning-face "brightred" "black")
    (font-lock-doc-face "white" "black")
    (font-lock-number-face "brightmagenta" "black")
    (completions-common-part "brightwhite" "black")
    (completions-first-difference "brightblue" "black")
    (completions-annotations "white" "black")
    (show-paren-match "black" "cyan")
    (show-paren-mismatch "black" "brightred")
    (dired-directory "brightblue" "black")
    (dired-symlink "cyan" "black")
    (dired-ignored "white" "black")
    (dired-warning "brightred" "black")
    (diff-added "green" "black")
    (diff-removed "brightred" "black")
    (diff-changed "yellow" "black")
    (diff-context "brightwhite" "black")
    (diff-header "brightblue" "black")
    (diff-file-header "brightblue" "black")
    (diff-hunk-header "cyan" "black")
    (diff-refine-added "black" "green")
    (diff-refine-removed "black" "brightred")
    (diff-refine-changed "black" "yellow")
    (diff-indicator-added "green" "black")
    (diff-indicator-removed "brightred" "black")
    (diff-indicator-changed "yellow" "black")
    (diff-changed-unspecified "yellow" "black")
    (diff-error "brightred" "black")
    (dired-broken-symlink "black" "brightred")
    (tooltip "brightwhite" "black")
    (tab-bar "white" "black")
    (tab-bar-tab "black" "brightblue")
    (tab-bar-tab-inactive "white" "black")
    (tab-bar-tab-group-current "black" "brightblue")
    (tab-line "white" "black")
    (isearch-group-1 "black" "brightcyan")
    (isearch-group-2 "black" "brightyellow")
    (isearch-fail "black" "brightred")
    (separator-line "white" "black")
    (tty-menu-enabled-face "brightwhite" "black")
    (tty-menu-disabled-face "white" "black")
    (tty-menu-selected-face "black" "brightblue")
    (read-multiple-choice-face "brightblue" "black")
    (help-key-binding "brightblue" "black")
    (window-divider "white" "black")
    (window-divider-first-pixel "white" "black")
    (window-divider-last-pixel "white" "black")
    (line-number-minor-tick "white" "black")
    (line-number-major-tick "white" "black")
    (tool-bar "white" "black")
    (cursor "black" "brightwhite")
    (region "black" "brightblue")
    (highlight "black" "brightblue")
    (isearch "black" "brightcyan")
    (lazy-highlight "black" "brightyellow")
    (match "black" "cyan")
    (minibuffer-prompt "brightblue" "black")
    (mode-line "brightwhite" "black")
    (mode-line-inactive "white" "black")
    (header-line "white" "black")
    (fringe "white" "black")
    (line-number "white" "black")
    (line-number-current-line "brightyellow" "black")
    (shadow "white" "black")
    (secondary-selection "black" "brightblue")
    (trailing-whitespace "black" "brightred")
    (success "green" "black")
    (warning "yellow" "black")
    (error "brightred" "black")
    (link "brightblue" "black")
    (link-visited "brightmagenta" "black")))

(defun lem-apply-terminal-colors (&optional frame)
  (let ((target (or frame (selected-frame))))
    (unless (display-graphic-p target)
      (dolist (entry lem-terminal-colors)
        (when (facep (car entry))
          (set-face-attribute (car entry) target
                              :foreground (nth 1 entry)
                              :background (nth 2 entry)
                              :weight 'normal))))))

(add-hook 'after-make-frame-functions #'lem-apply-terminal-colors)
(with-eval-after-load 'font-lock (lem-apply-terminal-colors))
(with-eval-after-load 'diff-mode (lem-apply-terminal-colors))
(with-eval-after-load 'dired (lem-apply-terminal-colors))
(with-eval-after-load 'paren (lem-apply-terminal-colors))
(lem-apply-terminal-colors)
