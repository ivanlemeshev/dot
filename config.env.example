# Personal configuration for dotfiles setup
# Copy this file to config.env and customize your values
# config.env is gitignored - your personal settings stay private

# Timezone configuration
export TIMEZONE="America/New_York"

# Machine configuration
export MACHINE_NAME="my-machine"

# Git configuration
export GIT_USER_NAME="Your Name"
export GIT_USER_EMAIL="your.email@example.com"
export GIT_DEFAULT_BRANCH="main"

# Fedora KDE Plasma configuration
export KDE_TERMINAL_FONT="JetBrainsMonoNL Nerd Font Mono,11,-1,5,50,0,0,0,0,0"

# Add more personal configs as needed
