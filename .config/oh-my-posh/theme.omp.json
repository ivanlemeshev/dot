{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#faf9f5",
          "style": "plain",
          "template": "╭─ ",
          "type": "text"
        },
        {
          "foreground": "#d97757",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "plain",
          "template": "{{ .CurrentDate | date .Format }}  ",
          "type": "time"
        },
        {
          "foreground": "#faf9f5",
          "style": "plain",
          "template": "{{ if ne .Env.POSH_SESSION_DEFAULT_USER .UserName }}<#5d9b75>{{ .UserName }}</><#faf9f5>@</></>{{ end }}<#5b8db8>{{ .HostName }}</>  ",
          "type": "session"
        },
        {
          "foreground": "#c94f4f",
          "style": "plain",
          "template": "󱐋  ",
          "type": "root"
        },
        {
          "foreground": "#faf9f5",
          "options": {
            "style": "folder"
          },
          "style": "plain",
          "template": "{{ .Path }}  ",
          "type": "path"
        },
        {
          "foreground": "#5d9b75",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#c94f4f{{ end }}",
            "{{ if gt .Ahead 0 }}#5b8db8{{ end }}",
            "{{ if gt .Behind 0 }}#d97757{{ end }}"
          ],
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": false
          },
          "style": "plain",
          "template": "git({{ .HEAD }}){{ if .Working.Changed }}<#d97757> {{ .Working.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }}{{ end }}{{ if .Staging.Changed }}<#5d9b75> {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} [{{ .StashCount }}] {{ end }}  ",
          "type": "git"
        },
        {
          "foreground": "#e9a17d",
          "options": {
            "style": "roundrock",
            "threshold": 500
          },
          "style": "plain",
          "template": "{{ .FormattedMs }}  ",
          "type": "executiontime"
        },
        {
          "foreground": "#5d9b75",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#c94f4f{{ end }}"
          ],
          "options": {
            "always_enabled": false
          },
          "style": "plain",
          "template": "{{ if gt .Code 0 }}exit({{ .Code }})  {{ end }}",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#58a6ad",
          "options": {
            "display_mode": "context"
          },
          "style": "plain",
          "template": "<#faf9f5>├─ </>python {{ .Full }}{{ if .Venv }} (venv){{ end }}  ",
          "type": "python"
        },
        {
          "foreground": "#58a6ad",
          "options": {
            "display_mode": "context"
          },
          "style": "plain",
          "template": "{{ if .Segments.Contains \"Python\" }}  {{ else }}<#faf9f5>├─ </>{{ end }}node {{ .Full }}  ",
          "type": "node"
        },
        {
          "foreground": "#58a6ad",
          "options": {
            "display_mode": "context"
          },
          "style": "plain",
          "template": "{{ if or (.Segments.Contains \"Python\") (.Segments.Contains \"Node\") }}  {{ else }}<#faf9f5>├─ </>{{ end }}rust {{ .Full }}  ",
          "type": "rust"
        },
        {
          "foreground": "#58a6ad",
          "options": {
            "display_mode": "context"
          },
          "style": "plain",
          "template": "{{ if or (.Segments.Contains \"Python\") (.Segments.Contains \"Node\") (.Segments.Contains \"Rust\") }}  {{ else }}<#faf9f5>├─ </>{{ end }}julia {{ .Full }}  ",
          "type": "julia"
        },
        {
          "foreground": "#58a6ad",
          "options": {
            "display_mode": "context"
          },
          "style": "plain",
          "template": "{{ if or (.Segments.Contains \"Python\") (.Segments.Contains \"Node\") (.Segments.Contains \"Rust\") (.Segments.Contains \"Julia\") }}  {{ else }}<#faf9f5>├─ </>{{ end }}go {{ .Full }}  ",
          "type": "go"
        },
        {
          "foreground": "#58a6ad",
          "options": {
            "display_mode": "context"
          },
          "style": "plain",
          "template": "{{ if or (.Segments.Contains \"Python\") (.Segments.Contains \"Node\") (.Segments.Contains \"Rust\") (.Segments.Contains \"Julia\") (.Segments.Contains \"Go\") }}  {{ else }}<#faf9f5>├─ </>{{ end }}zig {{ .Full }}  ",
          "type": "zig"
        },
        {
          "foreground": "#58a6ad",
          "options": {
            "display_mode": "context"
          },
          "style": "plain",
          "template": "{{ if or (.Segments.Contains \"Python\") (.Segments.Contains \"Node\") (.Segments.Contains \"Rust\") (.Segments.Contains \"Julia\") (.Segments.Contains \"Go\") (.Segments.Contains \"Zig\") }}  {{ else }}<#faf9f5>├─ </>{{ end }}lua {{ .Full }}  ",
          "type": "lua"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#faf9f5",
          "style": "plain",
          "template": "╰─ <#5d9b75>❯</>",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{if .Root}}root :: {{end}}{{.Shell}} :: {{.Folder}}",
  "final_space": true,
  "version": 4
}
