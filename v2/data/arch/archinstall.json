{
  "archinstall-language": "English",
  "bootloader": "Systemd-boot",
  "disk_config": {
    "config_type": "default_layout"
  },
  "filesystem": "ext4",
  "kernels": ["linux"],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "network_config": {
    "type": "iso"
  },
  "ntp": true,
  "packages": ["hyprland", "xdg-desktop-portal-hyprland", "sudo"],
  "profile_config": {
    "gfx_driver": "All open-source (default)",
    "greeter": "sddm",
    "profile": {
      "details": ["Hyprland"],
      "main": "Desktop"
    }
  }
}
