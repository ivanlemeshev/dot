{
  "editor.fontFamily": "JetBrainsMonoNL Nerd Font Mono, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": false,
  "editor.cursorBlinking": "solid",
  "terminal.integrated.cursorBlinking": false,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.rulers": [80, 100, 120],
  "editor.wordWrap": "on",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "window.density.layout": "compact",
  "[powershell]": {
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "workbench.iconTheme": "gruvbox-material-icon-theme",
  "workbench.colorTheme": "Ayu Dark Bordered",
  "cSpell.language": "en,ru-RU",
  "workbench.colorCustomizations": {
    "terminal.background": "#1F1D1B",
    "terminal.foreground": "#B4ADA5",
    "terminalCursor.foreground": "#B4ADA5",
    "terminalCursor.background": "#1F1D1B",
    "terminal.selectionBackground": "#959BA0",
    "terminal.ansiBlack": "#1F1D1B",
    "terminal.ansiRed": "#A38B7B",
    "terminal.ansiGreen": "#9B9B87",
    "terminal.ansiYellow": "#B5A18A",
    "terminal.ansiBlue": "#959BA0",
    "terminal.ansiMagenta": "#A99AA3",
    "terminal.ansiCyan": "#93A6A2",
    "terminal.ansiWhite": "#B4ADA5",
    "terminal.ansiBrightBlack": "#80746A",
    "terminal.ansiBrightRed": "#C2A394",
    "terminal.ansiBrightGreen": "#B7BAA0",
    "terminal.ansiBrightYellow": "#D0B79A",
    "terminal.ansiBrightBlue": "#B0B8C0",
    "terminal.ansiBrightMagenta": "#C5B1BD",
    "terminal.ansiBrightCyan": "#B1C6C1",
    "terminal.ansiBrightWhite": "#EBE1D2",
    "terminal.selectionForeground": "#1F1D1B",
    "editor.background": "#1F1D1B",
    "editor.selectionForeground": "#1F1D1B",
    "list.activeSelectionForeground": "#1F1D1B",
    "list.inactiveSelectionForeground": "#1F1D1B",
    "list.focusForeground": "#1F1D1B",
    "statusBar.background": "#1F1D1B",
    "statusBar.noFolderBackground": "#1F1D1B",
    "statusBar.debuggingBackground": "#1F1D1B",
    "sideBar.background": "#1F1D1B",
    "panel.background": "#1F1D1B",
    "editorWidget.background": "#1F1D1B",
    "input.background": "#1F1D1B",
    "editor.foreground": "#B4ADA5",
    "list.foreground": "#B4ADA5",
    "statusBar.foreground": "#B4ADA5",
    "statusBar.noFolderForeground": "#B4ADA5",
    "sideBar.foreground": "#B4ADA5",
    "input.foreground": "#B4ADA5",
    "editor.selectionBackground": "#959BA0",
    "editor.inactiveSelectionBackground": "#959BA0",
    "editor.selectionHighlightBackground": "#959BA0",
    "list.activeSelectionBackground": "#959BA0",
    "list.inactiveSelectionBackground": "#959BA0",
    "list.focusBackground": "#959BA0",
    "focusBorder": "#959BA0",
    "editorGroup.focusedEmptyBorder": "#959BA0",
    "panelTitle.activeBorder": "#959BA0",
    "terminal.border": "#80746A",
    "editorGroup.border": "#80746A",
    "editorWidget.border": "#80746A",
    "editorHoverWidget.border": "#80746A",
    "widget.border": "#80746A",
    "sideBar.border": "#80746A",
    "panel.border": "#80746A",
    "input.border": "#80746A",
    "dropdown.border": "#80746A",
    "editorLineNumber.foreground": "#80746A",
    "editorWhitespace.foreground": "#80746A",
    "editorLineNumber.activeForeground": "#B5A18A",
    "editorWarning.foreground": "#D0B79A",
    "list.highlightForeground": "#B5A18A",
    "statusBarItem.prominentForeground": "#B5A18A",
    "editorError.foreground": "#C2A394",
    "statusBar.debuggingForeground": "#C2A394",
    "editorInfo.foreground": "#93A6A2",
    "editorGutter.addedBackground": "#9B9B87",
    "editorGutter.deletedBackground": "#A38B7B",
    "editorGutter.modifiedBackground": "#B5A18A",
    "sideBarTitle.foreground": "#B5A18A",
    "panelTitle.activeForeground": "#B5A18A",
    "panelTitle.inactiveForeground": "#80746A"
  },
  "editor.tokenColorCustomizations": {
    "comments": "#80746A",
    "strings": "#9B9B87",
    "keywords": "#A38B7B",
    "numbers": "#A99AA3",
    "types": "#959BA0",
    "functions": "#B5A18A",
    "variables": "#B4ADA5"
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "variable": "#B4ADA5",
      "parameter": "#B4ADA5",
      "property": "#959BA0",
      "namespace": "#959BA0",
      "type": "#959BA0",
      "class": "#959BA0",
      "interface": "#959BA0",
      "enum": "#959BA0",
      "enumMember": "#A99AA3",
      "function": "#B5A18A",
      "method": "#B5A18A",
      "keyword": "#A38B7B",
      "string": "#9B9B87",
      "number": "#A99AA3",
      "comment": "#80746A"
    }
  }
}
