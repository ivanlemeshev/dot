#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$PROJECT_ROOT/lib/log.sh"
source "$PROJECT_ROOT/lib/print.sh"

show_banner() {
  if [ "${DOTFILES_BANNER:-}" != 1 ] && [ ! -t 1 ]; then
    return
  fi

  local can_reveal=0 column cursor_up="" frame green="" hide_cursor=""
  local line line_index reset="" show_cursor="" terminal_width="" width=0
  local -a logo=(
    '          _       _    __ _ _'
    '       __| | ___ | |_ / _(_) | ___  ___'
    '      / _` |/ _ \| __| |_| | |/ _ \/ __|'
    "     | (_| | (_) | |_|  _| | |  __/\\__ \\"
    '    . \__,_|\___/ \__|_| |_|_|\___||___/'
    ''
    '    > own your shell. shape your system.'
  )
  local -a spinner=('|' '/' '-' "\\")

  if [ -z "${NO_COLOR:-}" ]; then
    if command -v tput >/dev/null 2>&1; then
      green="$(tput setaf 2 2>/dev/null || true)"
      reset="$(tput sgr0 2>/dev/null || true)"
    fi
    green="${green:-$'\033[32m'}"
    reset="${reset:-$'\033[0m'}"
  fi

  for line in "${logo[@]}"; do
    if [ "${#line}" -gt "$width" ]; then
      width="${#line}"
    fi
  done

  if [ -t 1 ] && [ "${TERM:-}" != dumb ] && command -v tput >/dev/null 2>&1; then
    terminal_width="$(tput cols 2>/dev/null || true)"
    case "$terminal_width" in
      '' | *[!0-9]*) ;;
      *)
        if [ "$terminal_width" -lt "$width" ]; then
          logo=('.dotfiles' '> own your shell.')
          width="${#logo[1]}"
        fi
        ;;
    esac

    cursor_up="$(tput cuu "${#logo[@]}" 2>/dev/null || true)"
    hide_cursor="$(tput civis 2>/dev/null || true)"
    show_cursor="$(tput cnorm 2>/dev/null || true)"
    if [ -n "$cursor_up" ]; then
      can_reveal=1
    fi
  fi

  printf '\n'

  if [ "$can_reveal" -eq 1 ]; then
    trap 'printf "%s" "$show_cursor"' EXIT
    trap 'printf "%s" "$show_cursor"; exit 130' HUP INT TERM
    printf '%s' "$hide_cursor"

    for ((column = 1; column <= width; column++)); do
      for line_index in "${!logo[@]}"; do
        printf '%s%s%s\n' "$green" "${logo[$line_index]:0:$column}" "$reset"
      done
      sleep 0.06
      if [ "$column" -lt "$width" ]; then
        printf '%s' "$cursor_up"
      fi
    done

    sleep 0.5
    printf '%s' "$show_cursor"
    trap - EXIT HUP INT TERM
    printf '\n%sPreparing your environment...%s\n\n' "$green" "$reset"
  else
    for line in "${logo[@]}"; do
      printf '%s%s%s\n' "$green" "$line" "$reset"
    done
    printf '\n'
  fi

  if [ "$can_reveal" -eq 0 ] && [ -t 1 ] && [ "${TERM:-}" != dumb ]; then
    for frame in {0..14}; do
      printf '\r%s[%s] Preparing your environment...%s' \
        "$green" "${spinner[$((frame % ${#spinner[@]}))]}" "$reset"
      sleep 0.2
    done
    printf '\r%s[+] Preparing your environment...%s\n\n' "$green" "$reset"
  elif [ "$can_reveal" -eq 0 ]; then
    printf '%sPreparing your environment...%s\n\n' "$green" "$reset"
  fi
}

main() {
  local os

  show_banner
  os="$(uname -s)"

  if [[ "$os" == Linux && -f /etc/os-release ]]; then
    source /etc/os-release
    os="$NAME $VERSION_ID"
  fi

  print_key_value "OS" "$os"

  case "$os" in
    "Ubuntu "*)
      if [[ -f "$PROJECT_ROOT/bin/bootstrap-ubuntu.sh" ]]; then
        source "$PROJECT_ROOT/bin/bootstrap-ubuntu.sh"
      else
        log_fatal "bootstrap-ubuntu.sh not found" 1
      fi
      ;;
    "Fedora Linux "* | "Fedora "*)
      if [[ -f "$PROJECT_ROOT/bin/bootstrap-fedora.sh" ]]; then
        source "$PROJECT_ROOT/bin/bootstrap-fedora.sh"
      else
        log_fatal "bootstrap-fedora.sh not found" 1
      fi
      ;;
    "Darwin"*)
      if [[ -f "$PROJECT_ROOT/bin/bootstrap-macos.sh" ]]; then
        source "$PROJECT_ROOT/bin/bootstrap-macos.sh"
      else
        log_fatal "bootstrap-macos.sh not found" 1
      fi
      ;;
    *)
      log_fatal "Unsupported OS: $os" 1
      ;;
  esac
}

main "$@"
