{
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "keybindings": [
    {
      "id": "unbound",
      "keys": "ctrl+c"
    },
    {
      "id": "unbound",
      "keys": "ctrl+v"
    }
  ],
  "profiles": {
    "defaults": {
      "colorScheme": "custom",
      "font": {
        "face": "JetBrainsMonoNL Nerd Font Mono"
      }
    }
  },
  "schemes": [
    {
      "background": "#1F1D1B",
      "black": "#1F1D1B",
      "blue": "#6AA3E0",
      "brightBlack": "#403329",
      "brightBlue": "#8FBCF0",
      "brightCyan": "#82D9D9",
      "brightGreen": "#8AE8AE",
      "brightPurple": "#D9AAE8",
      "brightRed": "#EA8F8E",
      "brightWhite": "#EBE1D2",
      "brightYellow": "#F0C27A",
      "cursorColor": "#B4ADA5",
      "cyan": "#5EC4C4",
      "foreground": "#B4ADA5",
      "green": "#66DB96",
      "name": "custom",
      "purple": "#C58BD9",
      "red": "#DE7170",
      "selectionBackground": "#6AA3E0",
      "white": "#B4ADA5",
      "yellow": "#E4AC5D"
    }
  ],
  "themes": [
    {
      "name": "custom",
      "tab": {
        "background": "#1F1D1BFF",
        "iconStyle": "default",
        "showCloseButton": "always",
        "unfocusedBackground": null
      },
      "tabRow": {
        "background": "#1F1D1BFF",
        "unfocusedBackground": "#1F1D1BFF"
      },
      "window": {
        "applicationTheme": "dark",
        "experimental.rainbowFrame": false,
        "frame": null,
        "unfocusedFrame": null,
        "useMica": false
      }
    }
  ]
}
