#!/usr/bin/env bash
#MISE description="Check installed tool adapters"

set -euo pipefail

for tool in go golangci-lint julia lua node pnpm powershell python racket rust uv zig yt-dlp; do
  mise where "$tool"
done

for command_name in ansible bat batcat bwrap cc clang clang-format clang-tidy clangd cmake curl direnv fd fdfind ffmpeg fish fc-list fzf gcc gdb gh git ghostty htop jq less nvim pandoc pip3 pkg-config pwsh rg rustfmt shellcheck strace tmux tree tree-sitter unzip vim wget wt xxd yt-dlp grpcurl runic codex claude wl-copy xclip; do
  command -v "$command_name"
done

for command_name in go golangci-lint julia lua node pnpm pwsh python racket rustc uv zig yt-dlp; do
  mise which "$command_name"
done

go version
golangci-lint version
julia --startup-file=no --version
lua -v
node --version
pnpm --version
racket --version
uv --version
zig version
yt-dlp --version
python --version
rustc --version
tree-sitter --version
fzf --version
bat --version
wt --version
grpcurl -version
oh-my-posh --version
codex --version
claude --version
runic --help >/dev/null
pwsh -NoProfile -Command "\$PSVersionTable.PSVersion.ToString()"
fc-match --format '%{family}\n' 'JetBrainsMonoNL Nerd Font Mono' | grep -F 'JetBrainsMonoNL Nerd Font Mono'
racket_packages="$(raco pkg show --all)"
for package in racket-langserver racket-linter fmt sicp; do
  printf '%s\n' "$racket_packages" | grep -E "^[[:space:]]+${package}\*?[[:space:]]"
done

test -x "$HOME/.tmux/plugins/tpm/tpm"
test -d "$HOME/.tmux/plugins/tmux-yank"
