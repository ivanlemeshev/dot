#!/usr/bin/env bash
#MISE description="Remove Linux configuration and restore desktop settings"

set -euo pipefail
. /etc/os-release
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ "$ID" == fedora ]]; then
  python "$SCRIPT_DIR/../../fedora/state.py" unapply
else
  python "$SCRIPT_DIR/../../ubuntu/keyboard.py" unapply
fi
mise dot unapply --yes
python "$SCRIPT_DIR/../../linux/links.py" restore
