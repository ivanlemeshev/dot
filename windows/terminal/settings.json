{
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "keybindings": [
    {
      "id": "unbound",
      "keys": "ctrl+c"
    },
    {
      "id": "unbound",
      "keys": "ctrl+v"
    }
  ],
  "profiles": {
    "defaults": {
      "colorScheme": "Gruvbox Material Dark",
      "font": {
        "face": "JetBrainsMonoNL Nerd Font Mono"
      }
    }
  },
  "schemes": [
    {
      "background": "#121110",
      "black": "#121110",
      "blue": "#87A8BA",
      "brightBlack": "#716B66",
      "brightBlue": "#A4C2D0",
      "brightCyan": "#ACD0C8",
      "brightGreen": "#BBC49B",
      "brightPurple": "#D4A3B2",
      "brightRed": "#DD8768",
      "brightWhite": "#F6F1EC",
      "brightYellow": "#E9BA77",
      "cursorColor": "#F2E8DF",
      "cyan": "#8FBAB2",
      "foreground": "#E8E3DF",
      "green": "#AAB28A",
      "name": "Gruvbox Material Dark",
      "purple": "#BD8F9F",
      "red": "#C8785B",
      "selectionBackground": "#30221D",
      "white": "#E8E3DF",
      "yellow": "#D9A15F"
    }
  ],
  "themes": [
    {
      "name": "Gruvbox Material Dark",
      "tab": {
        "background": "#121110FF",
        "iconStyle": "default",
        "showCloseButton": "always",
        "unfocusedBackground": null
      },
      "tabRow": {
        "background": "#121110FF",
        "unfocusedBackground": "#30221DFF"
      },
      "window": {
        "applicationTheme": "dark",
        "experimental.rainbowFrame": false,
        "frame": null,
        "unfocusedFrame": null,
        "useMica": false
      }
    }
  ]
}
