{
  "editor.fontFamily": "JetBrainsMonoNL Nerd Font Mono, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": false,
  "editor.cursorBlinking": "solid",
  "terminal.integrated.cursorBlinking": false,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.rulers": [80, 100, 120],
  "editor.wordWrap": "on",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "window.density.layout": "compact",
  "[powershell]": {
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "workbench.iconTheme": "gruvbox-material-icon-theme",
  "workbench.colorTheme": "Ayu Dark Bordered",
  "cSpell.language": "en,ru-RU",
  "workbench.colorCustomizations": {
    "terminal.background": "#1D1F21",
    "terminal.foreground": "#D3D6D4",
    "terminalCursor.foreground": "#D3D6D4",
    "terminalCursor.background": "#1D1F21",
    "terminal.selectionBackground": "#88B4D9",
    "terminal.ansiBlack": "#1D1F21",
    "terminal.ansiRed": "#E07878",
    "terminal.ansiGreen": "#B4CA73",
    "terminal.ansiYellow": "#F3CA78",
    "terminal.ansiBlue": "#88B4D9",
    "terminal.ansiMagenta": "#C29CCD",
    "terminal.ansiCyan": "#78C9C1",
    "terminal.ansiWhite": "#D3D6D4",
    "terminal.ansiBrightBlack": "#999D9B",
    "terminal.ansiBrightRed": "#FF9993",
    "terminal.ansiBrightGreen": "#D3E78E",
    "terminal.ansiBrightYellow": "#FFE09A",
    "terminal.ansiBrightBlue": "#B1D0F2",
    "terminal.ansiBrightMagenta": "#DEB6E8",
    "terminal.ansiBrightCyan": "#A6E7DB",
    "terminal.ansiBrightWhite": "#F6F6F3",
    "terminal.selectionForeground": "#1D1F21",
    "editor.background": "#1D1F21",
    "editor.selectionForeground": "#1D1F21",
    "list.activeSelectionForeground": "#1D1F21",
    "list.inactiveSelectionForeground": "#1D1F21",
    "list.focusForeground": "#1D1F21",
    "statusBar.background": "#1D1F21",
    "statusBar.noFolderBackground": "#1D1F21",
    "statusBar.debuggingBackground": "#1D1F21",
    "sideBar.background": "#1D1F21",
    "panel.background": "#1D1F21",
    "editorWidget.background": "#1D1F21",
    "input.background": "#1D1F21",
    "editor.foreground": "#D3D6D4",
    "list.foreground": "#D3D6D4",
    "statusBar.foreground": "#D3D6D4",
    "statusBar.noFolderForeground": "#D3D6D4",
    "sideBar.foreground": "#D3D6D4",
    "input.foreground": "#D3D6D4",
    "editor.selectionBackground": "#88B4D9",
    "editor.inactiveSelectionBackground": "#88B4D9",
    "editor.selectionHighlightBackground": "#88B4D9",
    "list.activeSelectionBackground": "#88B4D9",
    "list.inactiveSelectionBackground": "#88B4D9",
    "list.focusBackground": "#88B4D9",
    "focusBorder": "#88B4D9",
    "editorGroup.focusedEmptyBorder": "#88B4D9",
    "panelTitle.activeBorder": "#88B4D9",
    "terminal.border": "#999D9B",
    "editorGroup.border": "#999D9B",
    "editorWidget.border": "#999D9B",
    "editorHoverWidget.border": "#999D9B",
    "widget.border": "#999D9B",
    "sideBar.border": "#999D9B",
    "panel.border": "#999D9B",
    "input.border": "#999D9B",
    "dropdown.border": "#999D9B",
    "editorLineNumber.foreground": "#999D9B",
    "editorWhitespace.foreground": "#999D9B",
    "editorLineNumber.activeForeground": "#F3CA78",
    "editorWarning.foreground": "#FFE09A",
    "list.highlightForeground": "#F3CA78",
    "statusBarItem.prominentForeground": "#F3CA78",
    "editorError.foreground": "#FF9993",
    "statusBar.debuggingForeground": "#FF9993",
    "editorInfo.foreground": "#78C9C1",
    "editorGutter.addedBackground": "#B4CA73",
    "editorGutter.deletedBackground": "#E07878",
    "editorGutter.modifiedBackground": "#F3CA78",
    "sideBarTitle.foreground": "#F3CA78",
    "panelTitle.activeForeground": "#F3CA78",
    "panelTitle.inactiveForeground": "#999D9B"
  },
  "editor.tokenColorCustomizations": {
    "comments": "#999D9B",
    "strings": "#B4CA73",
    "keywords": "#E07878",
    "numbers": "#C29CCD",
    "types": "#88B4D9",
    "functions": "#F3CA78",
    "variables": "#D3D6D4"
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "variable": "#D3D6D4",
      "parameter": "#D3D6D4",
      "property": "#88B4D9",
      "namespace": "#88B4D9",
      "type": "#88B4D9",
      "class": "#88B4D9",
      "interface": "#88B4D9",
      "enum": "#88B4D9",
      "enumMember": "#C29CCD",
      "function": "#F3CA78",
      "method": "#F3CA78",
      "keyword": "#E07878",
      "string": "#B4CA73",
      "number": "#C29CCD",
      "comment": "#999D9B"
    }
  }
}
