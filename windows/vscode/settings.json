{
  "editor.fontFamily": "JetBrainsMonoNL Nerd Font Mono, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": false,
  "editor.cursorBlinking": "solid",
  "terminal.integrated.cursorBlinking": false,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.rulers": [80, 100, 120],
  "editor.wordWrap": "on",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "window.density.layout": "compact",
  "[powershell]": {
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "workbench.iconTheme": "gruvbox-material-icon-theme",
  "workbench.colorTheme": "Ayu Dark Bordered",
  "cSpell.language": "en,ru-RU",
  "workbench.colorCustomizations": {
    "terminal.background": "#1F1D1B",
    "terminal.foreground": "#B4ADA5",
    "terminalCursor.foreground": "#B4ADA5",
    "terminalCursor.background": "#1F1D1B",
    "terminal.selectionBackground": "#6AA3E0",
    "terminal.ansiBlack": "#1F1D1B",
    "terminal.ansiRed": "#DE7170",
    "terminal.ansiGreen": "#66DB96",
    "terminal.ansiYellow": "#E4AC5D",
    "terminal.ansiBlue": "#6AA3E0",
    "terminal.ansiMagenta": "#C58BD9",
    "terminal.ansiCyan": "#5EC4C4",
    "terminal.ansiWhite": "#B4ADA5",
    "terminal.ansiBrightBlack": "#403329",
    "terminal.ansiBrightRed": "#EA8F8E",
    "terminal.ansiBrightGreen": "#8AE8AE",
    "terminal.ansiBrightYellow": "#F0C27A",
    "terminal.ansiBrightBlue": "#8FBCF0",
    "terminal.ansiBrightMagenta": "#D9AAE8",
    "terminal.ansiBrightCyan": "#82D9D9",
    "terminal.ansiBrightWhite": "#EBE1D2",
    "terminal.selectionForeground": "#1F1D1B",
    "editor.background": "#1F1D1B",
    "editor.selectionForeground": "#1F1D1B",
    "list.activeSelectionForeground": "#1F1D1B",
    "list.inactiveSelectionForeground": "#1F1D1B",
    "list.focusForeground": "#1F1D1B",
    "statusBar.background": "#1F1D1B",
    "statusBar.noFolderBackground": "#1F1D1B",
    "statusBar.debuggingBackground": "#1F1D1B",
    "sideBar.background": "#1F1D1B",
    "panel.background": "#1F1D1B",
    "editorWidget.background": "#1F1D1B",
    "input.background": "#1F1D1B",
    "editor.foreground": "#B4ADA5",
    "list.foreground": "#B4ADA5",
    "statusBar.foreground": "#B4ADA5",
    "statusBar.noFolderForeground": "#B4ADA5",
    "sideBar.foreground": "#B4ADA5",
    "input.foreground": "#B4ADA5",
    "editor.selectionBackground": "#6AA3E0",
    "editor.inactiveSelectionBackground": "#6AA3E0",
    "editor.selectionHighlightBackground": "#6AA3E0",
    "list.activeSelectionBackground": "#6AA3E0",
    "list.inactiveSelectionBackground": "#6AA3E0",
    "list.focusBackground": "#6AA3E0",
    "focusBorder": "#6AA3E0",
    "editorGroup.focusedEmptyBorder": "#6AA3E0",
    "panelTitle.activeBorder": "#6AA3E0",
    "terminal.border": "#403329",
    "editorGroup.border": "#403329",
    "editorWidget.border": "#403329",
    "editorHoverWidget.border": "#403329",
    "widget.border": "#403329",
    "sideBar.border": "#403329",
    "panel.border": "#403329",
    "input.border": "#403329",
    "dropdown.border": "#403329",
    "editorLineNumber.foreground": "#403329",
    "editorWhitespace.foreground": "#403329",
    "editorLineNumber.activeForeground": "#E4AC5D",
    "editorWarning.foreground": "#F0C27A",
    "list.highlightForeground": "#E4AC5D",
    "statusBarItem.prominentForeground": "#E4AC5D",
    "editorError.foreground": "#EA8F8E",
    "statusBar.debuggingForeground": "#EA8F8E",
    "editorInfo.foreground": "#5EC4C4",
    "editorGutter.addedBackground": "#66DB96",
    "editorGutter.deletedBackground": "#DE7170",
    "editorGutter.modifiedBackground": "#E4AC5D",
    "sideBarTitle.foreground": "#E4AC5D",
    "panelTitle.activeForeground": "#E4AC5D",
    "panelTitle.inactiveForeground": "#403329"
  },
  "editor.tokenColorCustomizations": {
    "comments": "#403329",
    "strings": "#66DB96",
    "keywords": "#DE7170",
    "numbers": "#C58BD9",
    "types": "#6AA3E0",
    "functions": "#E4AC5D",
    "variables": "#B4ADA5"
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "variable": "#B4ADA5",
      "parameter": "#B4ADA5",
      "property": "#6AA3E0",
      "namespace": "#6AA3E0",
      "type": "#6AA3E0",
      "class": "#6AA3E0",
      "interface": "#6AA3E0",
      "enum": "#6AA3E0",
      "enumMember": "#C58BD9",
      "function": "#E4AC5D",
      "method": "#E4AC5D",
      "keyword": "#DE7170",
      "string": "#66DB96",
      "number": "#C58BD9",
      "comment": "#403329"
    }
  }
}
